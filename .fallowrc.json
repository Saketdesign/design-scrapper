{
  "entry": [
    "js/main.js",
    "js/ui.js",
    "css/**/*.css",
    "scripts/*.js",
    "lib/sodium/lint/plugin.mjs"
  ],
  "ignorePatterns": ["test/fixtures/**"],
  "ignoreExports": [
    { "file": "js/defaults.js", "exports": ["*"] },
    { "file": "js/runner.js", "exports": ["recordFailure", "labelFor"] },
    { "file": "lib/sodium/lint/value-rules.mjs", "exports": ["LINT_IGNORES"] },
    { "file": "js/adapters/*.js", "exports": ["*"] }
  ],
  "duplicates": {
    "ignore": ["css/sodium/**", "lib/sodium/**"]
  },
  "health": {
    "ignore": ["lib/sodium/**", "sodium.eslint.config.mjs"]
  }
}
